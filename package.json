{
  "name": "@sqaoss/qr",
  "version": "0.0.0-development",
  "description": "Generate QR codes (PNG/SVG) from code, the terminal, or AI agents (MCP + skill).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "qr": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "author": "SQA & Automation SRL <ops@sqaoss.dev>",
  "homepage": "https://github.com/sqaoss/qr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqaoss/qr.git"
  },
  "bugs": {
    "url": "https://github.com/sqaoss/qr/issues"
  },
  "keywords": [
    "qr",
    "qr-code",
    "qrcode",
    "png",
    "svg",
    "cli",
    "mcp",
    "mcp-server",
    "agent-skills",
    "claude-code",
    "typescript"
  ],
  "scripts": {
    "clean": "bun -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun run clean && bun run build:js && bun run build:types",
    "build:js": "bun build --target=node --format=esm --splitting --packages=external --outdir dist src/index.ts src/cli.ts src/mcp.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "cli": "bun src/cli.ts",
    "check": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run build && vitest run --config vitest.config.e2e.ts",
    "audit": "bun audit",
    "audit:prod": "bun audit --production --json",
    "prepare": "husky",
    "prepublishOnly": "bun run build && node dist/cli.js --version"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,jsonc}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@modelcontextprotocol/client": "2.0.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "^22",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-v8": "5.0.1",
    "husky": "9.1.7",
    "jsqr": "1.4.0",
    "lint-staged": "17.5.1",
    "pngjs": "7.0.0",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "commander": "15.0.0",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  }
}
